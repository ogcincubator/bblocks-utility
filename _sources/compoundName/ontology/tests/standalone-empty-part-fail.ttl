# An untyped name part with a type but neither a label nor a reference fails NamePartShape.
@prefix com: <https://w3id.org/ogc/utils/label/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nametype: <http://www.example.com/nametypes/> .

[] rdfs:label "Albany Town Lot 57" ;
  dct:hasPart [ com:namePartType nametype:number ] .
