@prefix com: <https://w3id.org/ogc/utils/label/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <http://www.example.com/namedobjects/> .
@prefix nametype: <http://www.example.com/nametypes/> .

# a name part with only a type - it needs a label or a reference
ex:lot1 com:name [
    rdfs:label "IS II" ;
    dct:hasPart [ com:namePartType nametype:Stamp ]
  ] .
